{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LexZeon/airi-phoenix-local/character.schema.json",
  "title": "Local character card export configuration",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "description", "personality", "scenario", "systemPrompt", "greetings", "modules"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "nickname": {"type": "string"}, "creator": {"type": "string"},
    "description": {"type": "string", "minLength": 1},
    "personality": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "systemPrompt": {"type": "string", "minLength": 1},
    "postHistoryInstructions": {"type": "string"},
    "greetings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exampleMessages": {"type": "array", "items": {"type": "string", "pattern": "^\\{\\{(?:user|char)\\}\\}:"}},
    "notes": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "sourceUrls": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "modules": {
      "type": "object", "required": ["consciousness", "vision", "speech"],
      "properties": {
        "consciousness": {"$ref": "#/$defs/providerModel"},
        "vision": {"$ref": "#/$defs/providerModel"},
        "speech": {"allOf": [{"$ref": "#/$defs/providerModel"}, {"type": "object", "required": ["voice_id"], "properties": {"voice_id": {"type": "string"}}}]}
      }
    },
    "model": {"type": "object", "properties": {"type": {"const": "live2d"}, "settingsFile": {"type": "string"}, "binding": {"type": "string"}}},
    "expressions": {"type": "array", "items": {"type": "object", "required": ["name", "use"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}, "use": {"type": "string"}, "referenceId": {"type": "string"}}}}
  },
  "$defs": {"providerModel": {"type": "object", "required": ["provider", "model"], "properties": {"provider": {"type": "string"}, "model": {"type": "string"}}}}
}
